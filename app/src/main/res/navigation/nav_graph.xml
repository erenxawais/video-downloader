<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.videodownloader.HomeFragment"
        android:label="Home">
        <action
            android:id="@+id/action_home_to_result"
            app:destination="@id/resultFragment"/>
    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="com.example.videodownloader.ResultFragment"
        android:label="Result">
        <argument android:name="video_url" app:argType="string" android:defaultValue=""/>
    </fragment>

    <fragment
        android:id="@+id/downloadsFragment"
        android:name="com.example.videodownloader.DownloadsFragment"
        android:label="Downloads"/>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.videodownloader.ProfileFragment"
        android:label="Profile"/>
</navigation>
