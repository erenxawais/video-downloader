<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="14dp"
    android:paddingBottom="14dp"
    android:paddingTop="6dp">

    <LinearLayout
        android:id="@+id/navContainer"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/navbar_bg_pill"
        android:elevation="8dp"
        android:paddingHorizontal="8dp">

        <FrameLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/navbar_active_pill">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/iconHome"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/navebar_homeicon"
                    app:tint="@color/nav_active_text"/>
                <TextView
                    android:id="@+id/textHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Home"
                    android:textColor="@color/nav_active_text"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </FrameLayout>

        <FrameLayout android:id="@+id/navDownloads"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1">
            <ImageView android:id="@+id/iconDownloads"
                android:layout_width="24dp" android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/navebar_downloadicon"
                app:tint="@color/nav_icon_inactive"/>
        </FrameLayout>

        <FrameLayout android:id="@+id/navProfile"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1">
            <ImageView android:id="@+id/iconProfile"
                android:layout_width="24dp" android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/navebar_profileicon"
                app:tint="@color/nav_icon_inactive"/>
        </FrameLayout>

        <FrameLayout android:id="@+id/navApps"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1">
            <ImageView android:id="@+id/iconApps"
                android:layout_width="24dp" android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/navebar_moreapps"
                app:tint="@color/nav_icon_inactive"/>
        </FrameLayout>

    </LinearLayout>
</FrameLayout>
